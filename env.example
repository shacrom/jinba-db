# Supabase project credentials — never commit real values.
# Rename this file to `.env.example` locally (dotfile is blocked by the agent sandbox).
# Copy to `.env.local` and fill; `.env.local` is gitignored.

# Cloud project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Anon key (public; used by jinba-web via anon role)
SUPABASE_ANON_KEY=

# Service role key (secret; used by jinba-scraper and type generation)
SUPABASE_SERVICE_ROLE_KEY=

# Project reference (the `<ref>` in *.supabase.co). Needed for `supabase link`.
SUPABASE_PROJECT_REF=

# Types generation mode: `linked` (default) or `local`.
# SUPABASE_TYPES_MODE=linked
